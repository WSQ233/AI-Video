{
  "schema_version": "1.3",
  "project_name": "AI-Video",
  "git_repo": "https://github.com/WSQ233/AI-Video.git",
  "drive_root": "/content/drive/MyDrive/AI_Video",
  "shared_subdir": "shared",
  "default_project": "01_rainy_signal",
  "comfyui_dir": "/content/ComfyUI",
  "default_packs": [
    "minimax_h3_fl2va_bf16",
    "minimax_h3_turbo_lora"
  ],
  "model_load_mode": "copy_to_local",
  "copy_workers": 4,
  "gpu_profiles": {
    "A100_80GB": {
      "comfyui_args": "--normalvram --bf16-vae --listen 127.0.0.1 --port 8188",
      "install_sageattention": false,
      "recommended_packs": ["minimax_h3_fl2va_bf16", "minimax_h3_ref2va_bf16", "minimax_h3_turbo_lora", "minimax_h3_fl2va_int8_full"],
      "note": "A100 80GB 满血高配：使用 --normalvram 让 Qwen3-VL 编码后自动卸载，把完整 80GB HBM2e 独享给 61.7GB 的 33.1B 未剪枝 BF16 主模型，零 OOM 满速跑！"
    },
    "H100": {
      "comfyui_args": "--normalvram --bf16-vae --listen 127.0.0.1 --port 8188",
      "install_sageattention": false,
      "recommended_packs": ["minimax_h3_fl2va_bf16", "minimax_h3_ref2va_bf16", "minimax_h3_turbo_lora"],
      "note": "H100 80GB 同等满血高配"
    },
    "A100_40GB": {
      "comfyui_args": "--normalvram --bf16-vae --listen 127.0.0.1 --port 8188",
      "install_sageattention": false,
      "recommended_packs": ["minimax_h3_fl2va_int8_full", "minimax_h3_turbo_lora"],
      "note": "A100 40GB 回退配置：使用 33.1B 完整未剪枝 INT8-ConvRot (~31.7GB)"
    },
    "L4": {
      "comfyui_args": "--normalvram --listen 127.0.0.1 --port 8188",
      "install_sageattention": false,
      "recommended_packs": ["minimax_h3_fl2va_int8_full"],
      "note": "L4 兼容配置"
    },
    "DEFAULT": {
      "comfyui_args": "--normalvram --listen 127.0.0.1 --port 8188",
      "install_sageattention": false,
      "recommended_packs": ["minimax_h3_fl2va_int8_full"],
      "note": "通用兜底配置"
    }
  }
}
